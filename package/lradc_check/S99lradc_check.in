#!/bin/sh
### BEGIN INIT INFO
# Provides:          lradc_check
# Required-Start:    $remote_fs $network
# Required-Stop:     $remote_fs $network
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: LRADC key monitor
### END INIT INFO

DAEMON=/usr/bin/lradc_check   # cargo-package のデフォルトは /usr/bin
INPUT_DEV=/dev/input/event0
ADDR=0.0.0.0
PORT=@PORT@
PIDFILE=/var/run/lradc_check.pid

case "$1" in
  start)
    echo "Starting lradc_check on ${ADDR}:${PORT}"
    start-stop-daemon -S -b -m -p "${PIDFILE}" \
      --exec "${DAEMON}" -- "${INPUT_DEV}" "${ADDR}:${PORT}"
    ;;
  stop)
    echo "Stopping lradc_check"
    start-stop-daemon -K -p "${PIDFILE}" || true
    ;;
  restart)
    "$0" stop
    "$0" start
    ;;
  *)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
    ;;
esac

exit 0
